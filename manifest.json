{
  "manifest_version": 3,
  "name": "Sidecar",
  "short_name": "Sidecar",
  "version": "1.0.22",
  "description": "Arc-style vertical tabs for Chrome: spaces, pinned tabs, folders, favorites and auto-archiving, synced across computers.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "alarms",
    "favicon",
    "bookmarks",
    "search",
    "sessions",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Sidecar",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the sidebar"
    },
    "next-space": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Next space"
    },
    "prev-space": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Previous space"
    },
    "toggle-pin": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Period"
      },
      "description": "Pin / unpin the current tab"
    },
    "toggle-favorite": {
      "description": "Add / remove the current tab from Favorites"
    },
    "switch-tab": {
      "description": "Switch to a recent tab (keep holding the modifier and press again to go further back)"
    },
    "command-bar": {
      "description": "Command bar: type a URL or search, find a tab, or run a command"
    }
  }
}
